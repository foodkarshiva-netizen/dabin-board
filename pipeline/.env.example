# ---- Claude API (console.anthropic.com 에서 발급, 종량제 크레딧) ----
ANTHROPIC_API_KEY=sk-ant-...
MODEL_MAIN=claude-opus-5        # 구간 상세·종합 요약
MODEL_LIGHT=claude-sonnet-5     # 구간 분할·검증
MAX_COST_PER_VIDEO_USD=1.5      # 넘으면 자동 발행 대신 검토(초안)로

# ---- WordPress (사용자 → 프로필 → 애플리케이션 비밀번호 발급) ----
WP_URL=https://your-blog.example.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
BLOG_NAME=내 블로그 이름

# ---- 발행량·품질 게이트 (대량 생성 콘텐츠로 보이지 않게) ----
MAX_POSTS_PER_WEEK=5            # 최근 7일 안에 만든 글 상한(애드센스 심사 대비). 0 = 무제한
MAX_POSTS_PER_DAY=1             # 최근 24시간 상한. 0 = 무제한
REQUIRE_EDITOR_NOTE=0           # 1 이면 사람이 쓴 편집자 메모가 있어야 공개(기본 0 = AI 메모로 바로 공개)

# ---- 선택 ----
# 클라우드 IP에서 자막이 차단될 때 사용할 프록시 (http://user:pass@host:port)
YT_PROXY_URL=
# 1 이면 API 호출 없이 가짜 요약으로 흐름만 테스트
MOCK_LLM=

# ---- 스레드(Threads) 자동 발행 (docs/youtube-blog/THREADS_SETUP.md 참고) ----
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=https://jisikfill.com/
THREADS_AUTH_CODE=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_TOKEN_EXPIRES=
